{
  "name": "welight",
  "version": "0.0.1",
  "description": "Welight CLI —— 微信公众号 Markdown 排版与发布命令行工具（免费开源，全部 BYOK）",
  "type": "module",
  "bin": {
    "welight": "./dist/index.js",
    "wl": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.5"
  },
  "license": "MIT",
  "author": "Welight",
  "homepage": "https://github.com/08820048/welight-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/08820048/welight-cli"
  },
  "bugs": {
    "url": "https://github.com/08820048/welight-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wechat",
    "markdown",
    "wechat-mp",
    "公众号",
    "排版",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@crosscopy/clipboard": "^0.3.6",
    "c12": "^2.0.4",
    "commander": "^13.1.0",
    "fflate": "^0.8.2",
    "front-matter": "^4.0.2",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^2.36.0",
    "juice": "^11.1.1",
    "linkedom": "^0.18.13",
    "marked": "^17.0.1",
    "mermaid": "^11.16.1",
    "picocolors": "^1.1.1",
    "reading-time": "^1.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
